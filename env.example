# Copy to .env.local for local development.

# Neon pooled connection string. Vercel sets this automatically once you attach
# the Neon integration; copy the same value here to run the app locally.
#
# Paste it exactly as Neon gives it to you. Neon uses sslmode=require, which the
# app rewrites to verify-full at connect time (see lib/db.ts) -- pg is about to
# redefine `require` as unverified TLS, so it is pinned rather than trusted.
DATABASE_URL=postgresql://user:password@host-pooler.region.aws.neon.tech/dbname?sslmode=verify-full

# The admin password, in plain text. Anyone can read the checklist; only someone
# who has logged in at /login can change it.
#
# Left commented out, `next dev` treats every request as the admin, so local work
# needs no login step. A production build does the opposite with the same missing
# variable -- nobody can edit -- so set this in Vercel.
# SITE_PASSWORD=change-me
